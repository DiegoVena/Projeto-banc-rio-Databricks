from faker import Faker
import pandas as pd
import random

fake = Faker("pt_BR")

NUM_REGISTROS = 1000000

segmentos = [
    "VAREJO",
    "UNICLASS",
    "PERSONNALITE",
    "EMPRESARIAL",
    "PRIVATE"
]

tipos_conta = [
    "CORRENTE",
    "POUPANCA",
    "SALARIO"
]

status_conta = [
    "ATIVA",
    "BLOQUEADA",
    "ENCERRADA"
]

dados = []

for account_id in range(1, NUM_REGISTROS + 1):

    customer_id = random.randint(1, 1000000)

    agency_id = random.randint(1, 1200)

    account_number = f"{random.randint(10000,99999)}-{random.randint(0,9)}"

    account_type = random.choice(tipos_conta)

    segment = random.choices(
        segmentos,
        weights=[65, 20, 10, 3, 2]
    )[0]

    opened_at = fake.date_between(
        start_date="-10y",
        end_date="today"
    )

    status = random.choices(
        status_conta,
        weights=[90,5,5]
    )[0]

    dados.append({
        "account_id": account_id,
        "customer_id": customer_id,
        "agency_id": agency_id,
        "account_number": account_number,
        "account_type": account_type,
        "segment": segment,
        "opened_at": opened_at,
        "status": status
    })

df = pd.DataFrame(dados)

df.write \
    .format("delta") \
    .mode("overwrite") \
    .saveAsTable("bronze.default.accounts")

df.to_csv("accounts.csv", index=False, encoding="utf-8")

print(df.head())
print(f"\nTotal de registros: {len(df)}")
